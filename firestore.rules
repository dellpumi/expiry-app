rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function listPath(l) { return /databases/$(database)/documents/lists/$(l); }
    function memberPath(l, u) { return /databases/$(database)/documents/lists/$(l)/members/$(u); }
    function invitePath(l, e) { return /databases/$(database)/documents/lists/$(l)/invites/$(e); }
    function isMember(l) { return verified() && exists(memberPath(l, request.auth.uid)); }
    function isOwner(l) { return verified() && get(listPath(l)).data.ownerUid == request.auth.uid; }
    function isStr(v, mn, mx) { return v is string && v.size() >= mn && v.size() <= mx; }
    function isDateText(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validSP(d) { return (!('shop' in d) || isStr(d.shop, 0, 40)) && (!('priceFt' in d) || d.priceFt == null || (d.priceFt is int && d.priceFt >= 0 && d.priceFt <= 9999999)); }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','displayName','defaultListId','createdAt'])
        && request.resource.data.keys().hasAll(['email','displayName','defaultListId','createdAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && isStr(request.resource.data.displayName, 1, 15)
        && (request.resource.data.defaultListId == null || request.resource.data.defaultListId is string);
    }

    // Collection-group reads: my own memberships, and invitations to my verified email.
    match /{path=**}/members/{m} {
      allow read: if verified() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/invites/{i} {
      allow read: if verified() && resource.data.email == myEmail();
    }

    function validList(d) {
      return d.keys().hasOnly(['friendlyName','ownerUid','sharingEnabled','retentionDays','createdAt','updatedAt'])
        && isStr(d.friendlyName, 1, 35)
        && d.sharingEnabled is bool
        && d.retentionDays is int && d.retentionDays >= 1 && d.retentionDays <= 30
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }

    match /lists/{listId} {
      allow read: if isMember(listId);
      allow create: if verified()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sharingEnabled == false
        && validList(request.resource.data);
      allow update: if verified() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validList(request.resource.data);
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;

      function validMember(d, u) {
        return d.keys().hasOnly(['uid','listId','role','displayName','email','joinedAt'])
          && d.uid == u && d.listId == listId
          && (d.role == 'owner' || d.role == 'editor')
          && isStr(d.displayName, 1, 15)
          && d.email == myEmail()
          && d.joinedAt == request.time;
      }

      match /members/{memberUid} {
        allow read: if isMember(listId);
        allow create: if verified() && memberUid == request.auth.uid
          && validMember(request.resource.data, memberUid)
          && (
            // the owner's own row, written in the same batch as the list
            (request.resource.data.role == 'owner'
              && getAfter(listPath(listId)).data.ownerUid == request.auth.uid)
            ||
            // an editor row, written when accepting an invitation
            (request.resource.data.role == 'editor'
              && exists(invitePath(listId, myEmail()))
              && get(invitePath(listId, myEmail())).data.expiresAt > request.time
              && get(listPath(listId)).data.sharingEnabled == true)
          );
        allow delete: if (isOwner(listId) && resource.data.role == 'editor')
                      || (verified() && memberUid == request.auth.uid);
      }

      function validInvite(d, id) {
        return d.keys().hasOnly(['email','listId','listName','ownerName','invitedByUid','createdAt','expiresAt'])
          && d.email == id && id == id.lower()
          && d.listId == listId
          && isStr(d.listName, 1, 35) && isStr(d.ownerName, 1, 15)
          && d.invitedByUid == request.auth.uid
          && d.createdAt is timestamp && d.expiresAt is timestamp;
      }

      match /invites/{inviteId} {
        allow read: if isOwner(listId);
        allow create, update: if isOwner(listId)
          && get(listPath(listId)).data.sharingEnabled == true
          && validInvite(request.resource.data, inviteId);
        allow delete: if isOwner(listId) || (verified() && inviteId == myEmail());
      }

      function validInventory(d) {
        return d.keys().hasOnly(['name','quantity','expiresOn','createdAt','createdByUid','updatedAt','updatedByUid','shop','priceFt','assigneeUid'])
          && d.keys().hasAll(['name','quantity','expiresOn','createdAt','createdByUid','updatedAt','updatedByUid'])
          && isStr(d.name, 1, 80) && validSP(d)
          && d.quantity is int && d.quantity >= -99 && d.quantity <= 999
          && isDateText(d.expiresOn)
          && d.createdAt is timestamp && d.createdByUid is string
          && d.updatedByUid == request.auth.uid && d.updatedAt == request.time;
      }
      match /inventory/{itemId} {
        allow read, delete: if isMember(listId);
        allow create: if isMember(listId) && validInventory(request.resource.data)
                      && request.resource.data.quantity >= 1;
        allow update: if isMember(listId) && validInventory(request.resource.data);
      }

      function validShopping(d) {
        return d.keys().hasOnly(['name','quantity','assigneeUid','createdAt','createdByUid','updatedAt','updatedByUid',
                                 'shop','priceFt','gtin','shoppyProductId','packageSize'])
          && d.keys().hasAll(['name','quantity','assigneeUid','createdAt','createdByUid','updatedAt','updatedByUid'])
          && isStr(d.name, 1, 80) && validSP(d)
          && d.quantity is int && d.quantity >= -99 && d.quantity <= 999
          && (d.assigneeUid == null
              || (d.assigneeUid is string && exists(memberPath(listId, d.assigneeUid))))
          && (!('priceFt' in d) || d.priceFt == null || (d.priceFt is int && d.priceFt >= 0))
          && d.createdAt is timestamp && d.createdByUid is string
          && d.updatedByUid == request.auth.uid && d.updatedAt == request.time;
      }
      match /shopping/{itemId} {
        allow read, delete: if isMember(listId);
        allow create: if isMember(listId) && validShopping(request.resource.data)
                      && request.resource.data.quantity >= 1;
        allow update: if isMember(listId) && validShopping(request.resource.data);
      }

      function validArchive(d) {
        return d.keys().hasOnly(['name','quantity','expiresOn','source','deletedByUid','deletedByName','deletedAt','shop','priceFt','assigneeUid'])
          && d.keys().hasAll(['name','quantity','expiresOn','source','deletedByUid','deletedByName','deletedAt'])
          && isStr(d.name, 1, 80) && validSP(d)
          && d.quantity is int && d.quantity >= 1 && d.quantity <= 999
          && (d.expiresOn == null || isDateText(d.expiresOn))
          && (d.source == 'inventory' || d.source == 'shopping')
          && d.deletedByUid == request.auth.uid
          && isStr(d.deletedByName, 1, 15)
          && d.deletedAt == request.time;
      }
      match /archive/{itemId} {
        allow read, delete: if isMember(listId);
        allow create, update: if isMember(listId) && validArchive(request.resource.data);
      }
    }
  }
}
